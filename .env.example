# Copiá este archivo a .env.local (ignorado por git) y completá los valores.
# En local salen de `pnpm supabase status`; en Vercel se cargan como variables del proyecto.
# Solo van aquí claves públicas para el navegador: nunca la service role key ni secretos.

# URL de la API de Supabase (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=

# Anon / publishable key de Supabase (pública; la seguridad la da RLS)
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID para Web Push. Queda vacía hasta la fase 6.
VITE_VAPID_PUBLIC_KEY=
